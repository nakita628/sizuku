{
  "name": "sizuku-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "deps": "mkdir -p /tmp/pnpm-store && pnpm config set store-dir /tmp/pnpm-store &&rm -rf node_modules && rm -rf pnpm-lock.yaml && rm -rf ~/.pnpm-store && pnpm store prune && pnpm install --no-prefer-frozen-lockfile",
    "build": "pnpm -F sizuku build",
    "studio": "pnpm build && pnpm -F @examples/studio studio",
    "studio:diagram": "pnpm build && pnpm -F @examples/studio studio:diagram",
    "example": "pnpm build && pnpm -F @examples/studio generate",
    "check": "vp check --fix",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "release": "pnpm -F sizuku release"
  },
  "dependencies": {
    "sizuku": "link:packages/sizuku"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@11.11.0"
}
