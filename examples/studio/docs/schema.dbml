Table user {
  id uuid [pk, note: '主キー']
  email varchar [note: 'ログインに使うメールアドレス']
  name varchar [note: '表示名']
  createdAt timestamp [note: '表示名']
  updatedAt timestamp [note: '表示名']
}

Table organization {
  id uuid [pk, note: 'ユーザーが所属する組織']
  slug varchar [note: 'URL に使う識別子']
  name text [note: 'URL に使う識別子']
}

Table member {
  userId uuid [note: 'ユーザーと組織の所属（複合主キー）']
  organizationId uuid [note: 'ユーザーと組織の所属（複合主キー）']
  role memberRole [note: 'ユーザーと組織の所属（複合主キー）']
}

Table post {
  id uuid [pk, note: '記事']
  authorId uuid [note: '書いたユーザー（退会すると null）']
  organizationId uuid [note: '書いたユーザー（退会すると null）']
  title varchar [note: '書いたユーザー（退会すると null）']
  body text [note: '書いたユーザー（退会すると null）']
  published boolean [note: '書いたユーザー（退会すると null）']
  tags text [note: '書いたユーザー（退会すると null）']
}

Table comment {
  id uuid [pk, note: '記事へのコメント（返信は親コメントを指す）']
  postId uuid [note: '記事へのコメント（返信は親コメントを指す）']
  parentId uuid [note: '返信先のコメント']
  body text [note: '返信先のコメント']
  likes integer [note: '返信先のコメント']
}

Table auditLog {
  id uuid [pk, note: '操作の記録。外部キーは張らず、関係は注釈で示す']
  actorId uuid [note: '操作したユーザー（外部キーなし）']
  action varchar [note: '操作したユーザー（外部キーなし）']
  at timestamp [note: '操作したユーザー（外部キーなし）']
}

Ref member_userId_user_id_fk: member.userId > user.id

Ref member_organizationId_organization_id_fk: member.organizationId > organization.id

Ref post_authorId_user_id_fk: post.authorId > user.id

Ref post_organizationId_organization_id_fk: post.organizationId > organization.id

Ref comment_postId_post_id_fk: comment.postId > post.id

Ref comment_parentId_comment_id_fk: comment.parentId > comment.id

Ref auditLog_actorId_user_id: auditLog.actorId > user.id