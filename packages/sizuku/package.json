{
  "name": "sizuku",
  "version": "0.8.0",
  "description": "Sizuku is a tool that generates validation schemas for Zod and Valibot, as well as ER diagrams and DBML, from Drizzle schemas annotated with comments.",
  "keywords": [
    "dbml",
    "drizzle",
    "mermaid",
    "valibot",
    "zod"
  ],
  "homepage": "https://github.com/nakita628/sizuku",
  "bugs": {
    "url": "https://github.com/nakita628/sizuku/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/sizuku.git"
  },
  "bin": {
    "sizuku": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vp build -c vite.studio.config.ts",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "release": "npm pkg fix && pnpm build && npm publish",
    "studio:api": "hono-takibi",
    "studio:dev": "vp dev -c vite.studio.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/studio/client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@resvg/resvg-js": "^2.6.2",
    "effect": "^4.0.6",
    "hono": "^4.13.13",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.54.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.6",
    "@monaco-editor/react": "^4.7.0",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-orm": "^0.45.2",
    "hono-takibi": "^0.22.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "valibot": "1.4.1",
    "zustand": "^5.0.16"
  }
}
